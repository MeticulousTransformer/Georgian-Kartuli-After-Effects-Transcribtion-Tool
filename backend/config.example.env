# Kartuli Caption Forge — API keys
# Copy this file to:  backend/.env   then paste your keys after the = signs.
# Lines starting with # are comments. Empty values are ignored.

# ============ PRIMARY GEORGIAN PROVIDER ============
# ElevenLabs Scribe v2 — best Georgian word timestamps.
# Get key: https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# ============ OPENAI (whisper-1 word timestamps) ============
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============ GOOGLE CLOUD (Chirp 2/3) ============
# Path to your service-account JSON file (not the key itself):
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=eu

# ============ AZURE AI SPEECH (supports ka-GE) ============
# Get key: portal.azure.com -> Speech service resource -> Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# ============ GLADIA (Whisper cloud, Georgian OK) ============
# Get key: https://app.gladia.io
GLADIA_API_KEY=

# ============ ASSEMBLYAI (Georgian via nano model) ============
# Get key: https://www.assemblyai.com/app
ASSEMBLYAI_API_KEY=

# ============ BACKEND ============
# Port the After Effects panel connects to:
KCF_PORT=8765
